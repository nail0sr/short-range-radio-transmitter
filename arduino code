#define ANTENNA_PIN PB3 //Arduino Nano/Uno D11

// the setup function runs once when you press reset or power the board
void setup() {
	Serial.begin(2000000);

	//Carrier Frequency generation
	uint32_t fTransmit = 615; //KHz
	DDRB |= (1 << ANTENNA_PIN);
	TCCR2A = (0 << COM2A1) + (1 << COM2A0); //Toggle OC0A na poklapanje sa registerom COM2A 0 ili 1
	TCCR2A |= (1 << WGM21) + (0 << WGM20); //CTC za generisanje PWM signala 
	TCCR2B = (0 << CS22) + (0 << CS21) + (1 << CS20); //No Prescaling
  // Ovaj register oznacava ocitanu frekvenciju 
	OCR2A = F_CPU / (2048 * fTransmit) - 1;
	
	char strbuf[255];
  // formula za racunanje broadkast signala (Timer_speed/(2*(prescaler + brzina_samplovanja)/1000))
  // delimo sa hiljadu kako bismo dobili KHz ne HZ meru frekvencije
	sprintf(strbuf, "frekvencija na kojoj saljemo signal %d KHz", (F_CPU / (2 * (1 + OCR2A)) / 1000)); 
  Serial.println('\n');
  Serial.println(strbuf);

	//Setovanje registera i generisanje PWM signala
	TCCR1A |= (1 << WGM11) + (1 << WGM10); //Fast PWM 10 Bit
	TCCR1B = (1 << WGM12);					
	TCCR1B |= (0 << CS12) + (0 << CS11) + (1 << CS10); //BEZ prescale jedinice 
	TIMSK1 = (1 << OCIE1A) + (1 << TOIE1);

	//ADC Settings za konvertovanje input analog signala u digitalni za pwm modulaciju
	ADMUX = (1 << REFS1) + (1 << REFS0); //Reference internal 1.1V
	ADCSRA = (1 << ADEN) + (1 << ADSC) + (1 << ADATE); //Auto Trigger dozvoljen slobodan rad
	ADCSRA |= (1 << ADPS2) + (1 << ADPS1) + (0 << ADPS0); //podelom sa 64 dobijamo 18.5k brzinu samplovanja
  // data input direction register citanje analog to digital konvertovanog signala
	DIDR0 = (1 << ADC0D);

}


ISR(TIMER1_OVF_vect) {
  // ADCL se cita pre ADCH kako bismo ustanovili da 
	uint8_t adcl = ADCL;
	uint8_t adch = ADCH;
  // 8 bit uporedjivanje je dovoljno 
	OCR1A = (adch << 8) + adcl;
  // uporedjivanje data direction register B sa antena pinom bice {0:LOW, 1:HIGH}
	DDRB |= (1 << ANTENNA_PIN);
}

// za resetovanje antena pina i kontrolisanje tj modulacije signala 
// Data Direction Register B //
// Kada je DDRB0 = High antena pin je output pipeline uostalom resetovana je
ISR(TIMER1_COMPA_vect) {
	DDRB &= ~(1 << ANTENNA_PIN);
}

void loop() {

}
